{
  "name": "facturx-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme de conformite a la facturation electronique francaise (Factur-X) - Solution Compatible",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @facturx/core build && pnpm -r --filter '!@facturx/core' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "dev:web": "pnpm --filter @facturx/web dev",
    "validator:build": "docker build -t facturx-validator:local services/validator",
    "validator:up": "docker compose up -d validator",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "dev:validator": "docker compose up -d validator",
    "verify": "pnpm --filter @facturx/core build && pnpm lint && pnpm -r typecheck && pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
