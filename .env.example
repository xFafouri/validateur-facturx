# Copy to .env and adjust. Never commit .env.

# --- Validation sidecar -------------------------------------------------------
# Mustangproject service. Started by `pnpm validator:up`.
VALIDATOR_URL=http://127.0.0.1:8081
VALIDATOR_TIMEOUT_MS=30000

# --- Web ----------------------------------------------------------------------
# Overridable because port 3000 is often already taken locally.
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the web app reaches the API for the signed-in invoicing area. Server-to-server only:
# the browser never talks to the API directly, so there is one origin and no cross-site cookie.
API_URL=http://127.0.0.1:3001

# The API's own port. Distinct from PORT, which belongs to the web app: both apps read this same
# file, so a shared PORT would have them fighting over one socket.
API_PORT=3001

# --- Authentication -----------------------------------------------------------
# Session cookies carry `Secure` (and the `__Host-` prefix) in production. Set this to `false`
# only to run a production build over plain HTTP locally - a Secure cookie is never sent over
# http://, so sign-in silently fails to stick without it. Never `false` on a real deployment.
# AUTH_COOKIE_SECURE=true

# --- Outbound mail --------------------------------------------------------------
# Password resets and user invitations. With SMTP_HOST unset, messages are printed to the console
# instead of sent - so a developer can complete a reset by reading the link out of the terminal,
# with no provider account and no domain.
#
# Brevo (French, EU-hosted) is the documented default. The choice of an EU provider is deliberate:
# every address here belongs to a French accountant or one of their clients, and the relay is the
# last mile where that data could leave the EU.
#
# Two ways to reach it. The HTTP API is preferred and wins when both are set: outbound SMTP is
# blocked on most CI runners, many container platforms and plenty of ISPs, while 443 is open
# everywhere - and a refused sender comes back as a sentence rather than a socket timeout.
# Note that Brevo can restrict API keys to allowlisted IPs; a 401 naming an IP means that, not a
# bad key. The key is the one under SMTP & API > API Keys (xkeysib-…), not the SMTP key.
# BREVO_API_KEY=
#
# SMTP, for a relay other than Brevo. Any RFC-compliant server works.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
#
# The From address. Must be at a domain whose DNS carries your SPF and DKIM records - a Gmail
# address will not work, because Gmail's DMARC policy tells receivers to reject mail claiming to
# be @gmail.com that Google did not send.
# MAIL_FROM="Factur-X <noreply@votre-domaine.fr>"
#
# Set to `unavailable` to make a missing relay a hard failure rather than falling back to the
# console - appropriate for production, where silently printing a reset link is not acceptable.
# MAIL_TRANSPORT=

# --- Database (Phase 1) -------------------------------------------------------
# Host port for the compose Postgres. Move it if another project already binds 5432; the
# DATABASE_URL below must use the same port.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://facturx:facturx_dev_only@localhost:5432/facturx

# Where sealed invoice artifacts are written. Must be write-once storage in production
# (object storage with versioning and object-lock); the local driver is for development.
ARCHIVE_DIR=./.archive

# --- Queues (Phase 2) ---------------------------------------------------------
# Caching and rate limiting only. The transmission queue is NOT here: it lives in
# Postgres, because enqueueing has to commit with the invoice state change that
# justified it, and a duplicate send is a duplicate invoice at the buyer. See the
# header of apps/api/src/pdp/transmission.service.ts.
REDIS_URL=redis://localhost:6379

# --- Certified platform (Phase 2) --------------------------------------------
# `sandbox` uses the in-memory provider; no external calls are made. It is
# registered automatically outside production, and refused inside it unless
# PDP_SANDBOX_ENABLED=true - in production an accepting-but-delivering-nothing
# provider is a silent hole where a client's invoices go.
PDP_PROVIDER=sandbox
# PDP_SANDBOX_ENABLED=false

# Encrypts platform credentials before they reach the database (AES-256-GCM).
# Generate with: openssl rand -base64 32
# There is no default and no fallback: without it, saving a platform credential is
# refused rather than stored in clear. Rotating it makes existing credentials
# unreadable, and they must be re-entered.
PDP_CREDENTIALS_KEY=

# Public base URL of the API, used only to compose the webhook URL shown on the
# raccordements screen. Distinct from API_URL: that is the private address the web
# app uses, whereas a platform calls the webhook from the public internet. Left
# unset, the screen shows the path alone and says what to prefix.
# PDP_WEBHOOK_BASE_URL=https://api.votre-domaine.fr

# The worker that drains the transmission queue and polls the platforms.
# Off by default so a developer gets no outbound calls they did not ask for, and so
# tests are not racing a background timer against the rows they assert on.
PDP_WORKER_ENABLED=false
# PDP_QUEUE_INTERVAL_MS=15000
# PDP_POLL_INTERVAL_MS=60000

# --- Billing (Phase 1+) -------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Deployment ---------------------------------------------------------------
# Rate limiter keys on X-Forwarded-For. Set false if the app is exposed directly,
# otherwise a client can spoof the header and bypass the limit.
TRUST_PROXY=true
# Must be 'true' only in production, or staging will compete with it in search results.
NEXT_PUBLIC_ALLOW_INDEXING=false
