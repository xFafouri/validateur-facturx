# Copy to .env and adjust. Never commit .env.

# --- Validation sidecar -------------------------------------------------------
# Mustangproject service. Started by `pnpm validator:up`.
VALIDATOR_URL=http://127.0.0.1:8081
VALIDATOR_TIMEOUT_MS=30000

# --- Web ----------------------------------------------------------------------
# Overridable because port 3000 is often already taken locally.
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the web app reaches the API for the signed-in invoicing area. Server-to-server only:
# the browser never talks to the API directly, so there is one origin and no cross-site cookie.
API_URL=http://127.0.0.1:3001

# --- Authentication -----------------------------------------------------------
# Session cookies carry `Secure` (and the `__Host-` prefix) in production. Set this to `false`
# only to run a production build over plain HTTP locally - a Secure cookie is never sent over
# http://, so sign-in silently fails to stick without it. Never `false` on a real deployment.
# AUTH_COOKIE_SECURE=true

# --- Database (Phase 1) -------------------------------------------------------
# Host port for the compose Postgres. Move it if another project already binds 5432; the
# DATABASE_URL below must use the same port.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://facturx:facturx_dev_only@localhost:5432/facturx

# Where sealed invoice artifacts are written. Must be write-once storage in production
# (object storage with versioning and object-lock); the local driver is for development.
ARCHIVE_DIR=./.archive

# --- Queues (Phase 2) ---------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Certified platform (Phase 2) --------------------------------------------
# `sandbox` uses the in-memory provider; no external calls are made.
PDP_PROVIDER=sandbox

# --- Billing (Phase 1+) -------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Deployment ---------------------------------------------------------------
# Rate limiter keys on X-Forwarded-For. Set false if the app is exposed directly,
# otherwise a client can spoof the header and bypass the limit.
TRUST_PROXY=true
# Must be 'true' only in production, or staging will compete with it in search results.
NEXT_PUBLIC_ALLOW_INDEXING=false
