{
  "name": "@facturx/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API. Validation (Phase 0), invoicing and archiving (Phase 1); PDP and billing are skeletons.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@facturx/auth": "workspace:*",
    "@facturx/core": "workspace:*",
    "@facturx/db": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.5",
    "@nestjs/platform-express": "^11.0.5",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.8"
  }
}
