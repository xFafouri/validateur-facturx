{
  "name": "@facturx/mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Outbound transactional mail. A transport port with SMTP, console and in-memory drivers.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "send-test": "tsx scripts/send-test.ts"
  },
  "dependencies": {
    "nodemailer": "^7.0.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
