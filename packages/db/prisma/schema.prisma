// Data model for the Factur-X compliance platform.
//
// Modelled now, ahead of Phase 1, so the phases in the roadmap slot in without re-architecting.
// Three constraints shape almost every decision here:
//
//   1. TENANT ISOLATION. An accountant tenant holds many client businesses' data. Every
//      tenant-owned row carries `tenantId` directly rather than relying on a join to reach it,
//      so a scoping predicate can never be "forgotten" one level down a relation chain.
//
//   2. IMMUTABILITY. An invoice is a legal document. Issued invoices and archive entries are
//      never updated in place; corrections are new documents (an avoir, type code 381). Party
//      details are snapshotted per invoice rather than referenced, so that later edits to a
//      customer record cannot retroactively alter what a past invoice says.
//
//   3. EXACT MONEY. All amounts are `Decimal` (Postgres NUMERIC), never Float. A cent of
//      floating-point drift is exactly what makes BR-CO-10 fail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lead capture (Phase 0)
// ---------------------------------------------------------------------------

/// Which persona a signup identifies as. Drives what we build and who we talk to first.
enum LeadProfile {
  TPE
  ACCOUNTANT
  SOFTWARE_VENDOR
  OTHER
}

/// Waitlist signup from the public validator.
///
/// The only personal data Phase 0 stores, and the only conversion mechanism it has. Deliberately
/// minimal: an email, a self-declared persona, and the consent record. **No invoice data and no
/// validation results are stored here** - the validator promises uploads are analysed and
/// immediately forgotten, and a lead record that quietly carried invoice contents would make that
/// promise false.
///
/// `consentText` stores the exact wording the user agreed to, not a boolean: under GDPR, proving
/// consent means proving what was consented to, and that wording changes over time.
model Lead {
  id String @id @default(cuid())

  email   String      @unique
  profile LeadProfile @default(OTHER)

  /// Which page or state the signup came from, e.g. `validator-result-non-conforme`.
  source String?

  /// Verbatim consent wording shown at the time of signup.
  consentText String
  consentedAt DateTime @default(now())

  /// Set when the user asks to be removed; the row is retained only to honour the opt-out.
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([profile])
}

// ---------------------------------------------------------------------------
// Tenancy and identity
// ---------------------------------------------------------------------------

/// The account holder. A cabinet comptable is one Tenant owning many ClientOrgs.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  /// Tenant's own SIREN, when the tenant is itself a business.
  siren     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clientOrgs    ClientOrg[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
  archiveEntries ArchiveEntry[]
  subscription  Subscription?

  @@index([siren])
}

enum UserRole {
  OWNER
  ACCOUNTANT
  CLIENT_USER
}

model User {
  id       String   @id @default(cuid())
  tenantId String
  email    String   @unique
  name     String?
  role     UserRole @default(ACCOUNTANT)

  /// scrypt digest, in the self-describing format written by `@facturx/auth`. Null for a user
  /// who has been invited but has not yet set a password; such a user cannot sign in.
  passwordHash String?

  /// Set to lock an account out without deleting it. Deleting is not an option: the audit log
  /// references users by id, and an audit trail with dangling actors is not an audit trail.
  disabledAt  DateTime?
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// When set, this user may only see these client orgs - used for client-user logins.
  scopedClientOrgs ClientOrgUser[]
  sessions         Session[]
  credentialTokens CredentialToken[]

  @@index([tenantId])
}

/// A signed-in browser session.
///
/// Opaque server-side sessions rather than a self-contained token, for two reasons. First,
/// revocation: signing out, disabling an account or responding to a stolen laptop must take
/// effect immediately, and a stateless token stays valid until it expires no matter what the
/// database says. Second, the API verifies callers by reading this table directly, so identity
/// never has to be asserted by the web tier across a trust boundary.
///
/// `tokenHash` stores SHA-256 of the cookie value, never the value itself: a leaked backup or a
/// stray query log then yields no usable session. Plain SHA-256 is the right primitive here and
/// scrypt would not be - the token is 256 bits of CSPRNG output, so there is no guessable
/// preimage to slow an attacker down over.
model Session {
  id     String @id @default(cuid())
  userId String

  /// Hex-encoded SHA-256 of the opaque session token held by the client.
  tokenHash String @unique

  expiresAt DateTime
  /// Set on sign-out. The row is kept rather than deleted so that "when did this session end"
  /// remains answerable during an incident review.
  revokedAt DateTime?

  /// Refreshed lazily, not on every request - see the note on idle rotation in `@facturx/auth`.
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// An end business whose invoicing the tenant manages.
model ClientOrg {
  id       String @id @default(cuid())
  tenantId String

  name  String
  /// 9 digits, checksum-validated on entry.
  siren String
  /// 14 digits. Establishment-level; needed for Annuaire routing.
  siret String?
  vatNumber String?

  /// Electronic address used for routing (BT-34 for the seller side).
  eInvoicingAddress String?
  /// Scheme of the address above, e.g. `0009` for a French SIRET.
  eInvoicingScheme  String?

  addressLine1 String?
  addressLine2 String?
  postcode     String?
  city         String?
  countryCode  String  @default("FR")

  /// Emitted profile for this client. Defaults to BASIC; see profiles.ts for the rationale.
  defaultProfile String @default("BASIC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft-delete: archived invoices must outlive the client record by up to ten years.
  archivedAt DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  pdpConnections PdpConnection[]
  users          ClientOrgUser[]
  eReports       EReport[]

  @@unique([tenantId, siren])
  @@index([tenantId])
  @@index([siren])
}

/// Join table restricting a client-user to specific client orgs.
model ClientOrgUser {
  userId      String
  clientOrgId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Cascade)

  @@id([userId, clientOrgId])
  @@index([clientOrgId])
}

/// Why a one-time credential link was issued.
enum CredentialTokenPurpose {
  /// Sent to someone who asked to reset a forgotten password.
  PASSWORD_RESET
  /// Sent to a new user so they can choose their own password and activate their access.
  INVITATION
}

/// A single-use link emailed to a user, for setting a password.
///
/// The same discipline as `Session`: only SHA-256 of the token is stored, so a leaked backup or a
/// stray query log yields nothing usable. Plain SHA-256 rather than scrypt for the same reason -
/// the token is 256 bits of CSPRNG output, so there is no guessable preimage to slow down over.
///
/// `usedAt` rather than deleting the row on use. A reset link that has already been used is a
/// meaningfully different thing from one that never existed: the first is worth telling the user
/// about ("this link has already been used"), and the second is worth logging. Rows are cleaned up
/// on expiry, not on use.
model CredentialToken {
  id     String @id @default(cuid())
  userId String

  purpose   CredentialTokenPurpose
  /// Hex-encoded SHA-256 of the token in the emailed link.
  tokenHash String                 @unique

  expiresAt DateTime
  usedAt    DateTime?
  /// Set when a newer token supersedes this one, so only the most recent link works.
  invalidatedAt DateTime?

  /// Who triggered it, for an invitation. Null for a self-service reset.
  createdByUserId String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------------

enum InvoiceDirection {
  ISSUED
  RECEIVED
}

enum InvoiceState {
  DRAFT
  VALIDATED
  QUEUED
  TRANSMITTED
  DELIVERED
  REJECTED
  ARCHIVED
}

/// Party identity as it stood when the invoice was issued.
///
/// Snapshotted, not referenced: editing a customer's address must never change what a past
/// invoice says, because the invoice is the legal record of that transaction.
model Party {
  id String @id @default(cuid())

  name        String
  legalId     String?
  legalScheme String?
  vatNumber   String?
  eAddress    String?
  eScheme     String?

  addressLine1 String?
  addressLine2 String?
  postcode     String?
  city         String?
  countryCode  String?

  createdAt DateTime @default(now())

  invoicesAsSeller Invoice[] @relation("SellerParty")
  invoicesAsBuyer  Invoice[] @relation("BuyerParty")
}

model Invoice {
  id          String @id @default(cuid())
  tenantId    String
  clientOrgId String

  direction InvoiceDirection
  state     InvoiceState     @default(DRAFT)

  /// BT-1. Unique per issuing client org; the CGI requires unbroken sequential numbering.
  invoiceNumber String
  /// BT-3. 380 invoice, 381 credit note.
  typeCode      String   @default("380")
  /// BT-2.
  issueDate     DateTime @db.Date
  /// BT-9.
  dueDate       DateTime? @db.Date
  /// BT-5.
  currency      String   @default("EUR")
  /// BT-10.
  buyerReference String?

  /// Factur-X profile emitted, or the profile the received document declared.
  profile String @default("BASIC")

  sellerPartyId String
  buyerPartyId  String

  /// The other party's SIREN: the buyer's on an issued invoice, the supplier's on a received one.
  ///
  /// Denormalised from the `Party` snapshot purely so it can be indexed. Party rows are written
  /// fresh per invoice, so they cannot carry a uniqueness constraint that spans invoices - and
  /// "this supplier already sent us that number" is exactly such a constraint.
  counterpartyLegalId String?

  /// When the document reached us. Null for invoices we issued.
  receivedAt DateTime?

  /// How it arrived - `upload`, and later a platform adapter key. Null for issued invoices.
  sourceChannel String?

  // Totals. NUMERIC, never Float - see the header note.
  //
  // Nullable, which they were not while only issued invoices existed. A received invoice may be
  // malformed - that is the whole reason this product exists - and one that omits BT-112 has to
  // be recorded as omitting it. Storing a placeholder zero would put a false amount in front of
  // an accountant, which is worse than an obvious gap. The guarantee for invoices *we* issue is
  // not weakened: a CHECK constraint (see the migration) still requires every total on ISSUED.
  /// BT-106
  lineTotalAmount     Decimal? @db.Decimal(19, 4)
  /// BT-107
  allowanceTotalAmount Decimal? @default(0) @db.Decimal(19, 4)
  /// BT-108
  chargeTotalAmount   Decimal? @default(0) @db.Decimal(19, 4)
  /// BT-109
  taxBasisTotalAmount Decimal? @db.Decimal(19, 4)
  /// BT-110
  taxTotalAmount      Decimal? @db.Decimal(19, 4)
  /// BT-112
  grandTotalAmount    Decimal? @db.Decimal(19, 4)
  /// BT-113
  prepaidAmount       Decimal? @default(0) @db.Decimal(19, 4)
  /// BT-115
  duePayableAmount    Decimal? @db.Decimal(19, 4)

  /// Last validation verdict, cached for list views.
  lastValidationValid Boolean?
  lastValidatedAt     DateTime?

  /// Error count from the last validation, so a list can rank the worst first without re-running.
  validationErrorCount Int?

  /// Rule ids that fired, e.g. `["BR-CO-10", "BR-DE-15"]`. Enough to explain a verdict in a list
  /// without storing the whole engine report; the sealed artifact can always be re-validated.
  validationRuleIds Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Cascade)
  seller    Party     @relation("SellerParty", fields: [sellerPartyId], references: [id])
  buyer     Party     @relation("BuyerParty", fields: [buyerPartyId], references: [id])

  lines            InvoiceLine[]
  taxBreakdown     TaxBreakdown[]
  lifecycleStatuses LifecycleStatus[]
  archiveEntries   ArchiveEntry[]
  transmissions    Transmission[]

  // Uniqueness of the invoice number is deliberately NOT declared here, because it is two
  // different rules depending on direction, and Prisma's DSL cannot express either:
  //
  //   - ISSUED: unique per client org. The CGI requires unbroken, duplicate-free numbering, and
  //     that is an obligation on the *issuer*.
  //   - RECEIVED: unique per client org *and supplier*. Two suppliers reusing `FA-2026-001` is
  //     entirely normal, and the earlier constraint - which spanned direction but not the
  //     counterparty - would have rejected the second supplier's invoice as a duplicate.
  //
  // Both are partial unique indexes, written by hand in the migration.
  @@index([tenantId, state])
  @@index([tenantId, direction, issueDate])
  @@index([clientOrgId, issueDate])
  @@index([counterpartyLegalId])
}

model InvoiceLine {
  id        String @id @default(cuid())
  invoiceId String

  /// BT-126
  lineId      String
  /// BT-153
  name        String
  /// BT-154
  description String?
  /// BT-129
  quantity    Decimal @db.Decimal(19, 4)
  /// BT-130, UN/ECE Rec 20.
  unitCode    String  @default("C62")
  /// BT-146
  netUnitPrice Decimal @db.Decimal(19, 4)
  /// BT-131. These must sum to the invoice's BT-106 - the BR-CO-10 rule.
  netAmount    Decimal @db.Decimal(19, 4)
  /// BT-151, UNTDID 5305.
  vatCategoryCode String @default("S")
  /// BT-152
  vatRatePercent  Decimal @db.Decimal(6, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineId])
  @@index([invoiceId])
}

/// VAT subtotal per rate (BG-23). Required by EN 16931 even for exempt invoices.
model TaxBreakdown {
  id        String @id @default(cuid())
  invoiceId String

  /// BT-116
  basisAmount     Decimal @db.Decimal(19, 4)
  /// BT-117
  calculatedAmount Decimal @db.Decimal(19, 4)
  /// BT-118
  categoryCode    String
  /// BT-119
  ratePercent     Decimal @db.Decimal(6, 2)
  /// BT-120
  exemptionReason String?
  /// BT-121
  exemptionCode   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, categoryCode, ratePercent])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Platform integration and lifecycle
// ---------------------------------------------------------------------------

/// Where a status came from. Statuses feed VAT reporting, so provenance is not optional.
enum StatusSource {
  INTERNAL
  PA
  PPF
}

/// Lifecycle status (transmission and business processing families).
///
/// Append-only: a status history is evidence. Superseded statuses stay.
model LifecycleStatus {
  id        String @id @default(cuid())
  invoiceId String

  /// DGFiP status code, e.g. deposited, received, rejected, approved.
  code      String
  label     String?
  source    StatusSource
  occurredAt DateTime
  recordedAt DateTime @default(now())
  /// Raw payload from the platform, kept verbatim for dispute resolution.
  payload   Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// What makes polling idempotent.
  ///
  /// Statuses are fetched by a cursor, and any cursor that is not advanced transactionally with
  /// the write it covers will re-deliver its last window after a crash. Deduplicating in the
  /// database rather than by reading first means two concurrent pollers cannot both check, both
  /// find nothing, and both insert. Two genuinely distinct events sharing a code *and* a
  /// timestamp to the millisecond is not something a platform emits; a replay is.
  @@unique([invoiceId, code, occurredAt])
  @@index([invoiceId, occurredAt])
}

/// Credentials and routing for one client org's certified platform (PA).
model PdpConnection {
  id          String @id @default(cuid())
  clientOrgId String

  /// Adapter key selecting the PdpProvider implementation.
  provider String
  /// Human label shown in the UI.
  label    String?

  apiBaseUrl String?
  /// Encrypted at the application layer before it reaches the database; never stored in clear.
  credentialsEncrypted Bytes?
  /// PEPPOL participant identifier, when the transport is PEPPOL eDelivery.
  peppolAddress String?

  active    Boolean  @default(true)

  // Poll watermarks, one per flow, because the two move independently: a burst of inbound
  // invoices must not drag the status cursor past statuses that have not been read yet.
  //
  // Deliberately *behind* the truth. Each is advanced only to the timestamp of the last item
  // actually written, so a crash mid-batch re-reads that item rather than skipping it. Re-reading
  // is free - statuses deduplicate on their unique constraint and inbound invoices on their
  // content hash - whereas skipping loses a payable or a status that feeds a VAT return.
  statusCursor  DateTime?
  inboundCursor DateTime?
  lastPolledAt  DateTime?

  /// Outcome of the last credential check, so the settings screen can show a connection is broken
  /// before an invoice fails to send rather than after.
  lastVerifiedAt DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientOrg     ClientOrg      @relation(fields: [clientOrgId], references: [id], onDelete: Cascade)
  transmissions Transmission[]

  /// One connection per platform per business. A second row for the same adapter would be two
  /// sets of credentials for one account, and nothing could say which is authoritative.
  @@unique([clientOrgId, provider])
  @@index([clientOrgId])
  @@index([active])
}

enum TransmissionState {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
}

/// One invoice's handover to a platform - and the queue that drives it.
///
/// Separate from Invoice because transmission is retried: the invoice has one state, but the
/// handover may take many attempts, and the failure history matters when a client disputes
/// delivery.
///
/// **This table is the queue.** There is no broker. A job for a send that never happened, or two
/// jobs for one send, are both duplicate invoices at the buyer - a fiscal problem, not a
/// technical one - and no amount of care in application code makes a write to Redis and a write
/// to Postgres agree. Here the row *is* the work item, so enqueueing is the same commit as the
/// state change that justified it, and `idempotencyKey` is a database constraint rather than a
/// convention. Workers claim rows with `FOR UPDATE SKIP LOCKED`; see `TransmissionService`.
model Transmission {
  id              String @id @default(cuid())
  invoiceId       String
  pdpConnectionId String

  state    TransmissionState @default(PENDING)
  /// Deduplication key sent to the platform so a retry cannot produce a duplicate invoice.
  ///
  /// Derived from the sealed content hash, not generated per attempt: the same document must
  /// present the same key however many times we try to hand it over. Unique across the table, so
  /// a double enqueue is refused by Postgres instead of being caught by a prior read that two
  /// concurrent callers could both pass.
  idempotencyKey String  @unique
  attempt        Int     @default(1)
  /// Identifier the platform assigned, once known.
  externalId     String?
  lastError      String?

  /// When this row next becomes eligible. Exponential backoff writes the future here.
  nextAttemptAt DateTime @default(now())
  /// Lease held by the worker currently running this row, and by whom.
  ///
  /// A claim that is never released - the worker was killed mid-attempt - is reclaimable once the
  /// lease goes stale. Without it, one `kill -9` strands an invoice as PENDING forever, which is
  /// indistinguishable to the user from us having silently dropped it.
  claimedAt DateTime?
  claimedBy String?

  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  acknowledgedAt DateTime?

  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  pdpConnection PdpConnection @relation(fields: [pdpConnectionId], references: [id])

  @@index([invoiceId])
  @@index([state])
  /// The claim query's index: due work, oldest first.
  @@index([state, nextAttemptAt])
  @@index([externalId])
}

// ---------------------------------------------------------------------------
// Archiving and audit
// ---------------------------------------------------------------------------

/// Immutable stored artifact.
///
/// Content-addressed by SHA-256 so integrity is provable, and never updated - a new version is a
/// new row. `retentionUntil` encodes the statutory retention period; the exact duration must be
/// confirmed against DGFiP guidance before go-live.
///
/// ## An entry is a record about one invoice, not a record about the bytes
///
/// The distinction cost us a bug. The uniqueness here was originally `(tenantId, contentHash)`,
/// which reads as "these bytes are archived once per tenant" - true of the *blob*, and the store
/// already guarantees it, since `storageKey` is derived from the hash and identical bytes rewrite
/// to the same key.
///
/// But an entry is not the blob. It says *this invoice's* artifact is these bytes, and it carries
/// that invoice's retention deadline. One set of bytes is legitimately two invoices whenever a
/// cabinet manages both sides of a trade: company A invoices company B, both are the tenant's
/// client businesses, and the identical PDF is A's issued invoice and B's received one. Under the
/// old constraint the second one silently got no entry at all - `seal` found the first and
/// returned it - so a received invoice existed with no retrievable artifact, its download 404ed,
/// and receiving it again failed on the invoice-number index instead of deduplicating.
model ArchiveEntry {
  id        String  @id @default(cuid())
  tenantId  String
  invoiceId String?

  /// SHA-256 of the stored bytes, hex-encoded.
  contentHash String
  /// Object-storage key. Storage must be write-once.
  storageKey  String
  mimeType    String
  sizeBytes   Int
  /// `facturx-pdf`, `cii-xml`, ...
  artifactKind String

  sealedAt       DateTime @default(now())
  retentionUntil DateTime

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  /// Re-sealing the same artifact for the same invoice is idempotent; sealing it for a *different*
  /// invoice is a different fact and gets its own row. Postgres treats NULLs as distinct, so this
  /// does not constrain unattached entries - a partial index in the migration covers those.
  @@unique([tenantId, invoiceId, contentHash])
  @@index([invoiceId])
  @@index([tenantId, contentHash])
  @@index([retentionUntil])
}

/// Append-only record of every material action.
///
/// No `updatedAt`, and nothing here is ever mutated: an audit log that can be edited is not an
/// audit log. Writes should be enforced insert-only at the database role level.
model AuditLog {
  id       String @id @default(cuid())
  tenantId String

  /// Who acted. Null for system/worker actions.
  userId   String?
  /// e.g. `invoice.issued`, `invoice.transmitted`, `client_org.created`.
  action   String
  /// Entity type and id the action concerned.
  entityType String
  entityId   String

  /// Structured detail; must not contain secrets.
  metadata  Json?
  ipAddress String?
  userAgent String?

  occurredAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// e-reporting (Phase 4) and billing
// ---------------------------------------------------------------------------

enum EReportKind {
  B2C
  CROSS_BORDER
  PAYMENT
}

/// Transaction data reported to the tax authority outside the B2B invoice flow.
model EReport {
  id          String @id @default(cuid())
  clientOrgId String

  kind        EReportKind
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  totalAmount Decimal @db.Decimal(19, 4)
  taxAmount   Decimal @db.Decimal(19, 4)
  currency    String  @default("EUR")

  submittedAt DateTime?
  payload     Json?

  createdAt DateTime @default(now())

  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Cascade)

  @@index([clientOrgId, periodStart])
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique

  /// Stripe identifiers only. No card data ever touches this system.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 String  @default("free")
  status               String  @default("active")
  /// Managed-client count for per-seat billing of the accountant plan.
  seatCount            Int     @default(0)

  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
