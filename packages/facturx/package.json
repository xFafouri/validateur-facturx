{
  "name": "@facturx/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Factur-X / CII parsing, extraction and validation core. Framework-agnostic.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-samples": "bash ./scripts/fetch-samples.sh",
    "demo": "tsx scripts/make-demo-invoices.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
